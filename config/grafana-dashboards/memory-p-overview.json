{
  "dashboard": {
    "title": "MEMORY_P v2.0 Overview",
    "tags": ["memory-p", "search-engines", "performance"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
        "type": "graph",
        "title": "Search Engine Latency (P99)",
        "targets": [
          {
            "expr": "histogram_quantile(0.99, rate(search_duration_seconds_bucket[5m]))",
            "legendFormat": "{{engine}} - P99"
          }
        ]
      },
      {
        "id": 2,
        "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
        "type": "graph",
        "title": "Throughput (Queries/sec)",
        "targets": [
          {
            "expr": "rate(search_total[5m])",
            "legendFormat": "{{engine}}"
          }
        ]
      },
      {
        "id": 3,
        "gridPos": {"x": 0, "y": 8, "w": 8, "h": 6},
        "type": "stat",
        "title": "Qdrant Health",
        "targets": [
          {
            "expr": "up{job=\"qdrant\"}",
            "legendFormat": "Status"
          }
        ]
      },
      {
        "id": 4,
        "gridPos": {"x": 8, "y": 8, "w": 8, "h": 6},
        "type": "stat",
        "title": "MeiliSearch Health",
        "targets": [
          {
            "expr": "up{job=\"meilisearch\"}",
            "legendFormat": "Status"
          }
        ]
      },
      {
        "id": 5,
        "gridPos": {"x": 16, "y": 8, "w": 8, "h": 6},
        "type": "stat",
        "title": "LNX Cluster Health",
        "targets": [
          {
            "expr": "count(up{job=\"lnx-cluster\"} == 1)",
            "legendFormat": "Active Nodes"
          }
        ]
      }
    ],
    "refresh": "10s",
    "schemaVersion": 30,
    "version": 1
  }
}
